    { "id": "jokbo-royal", "level": "jokbo", "eras": ["1592"], "template": "선원록. {term} {name}. {birthReign} 생, {deathReign} {month}월 졸." },
    { "id": "munjip-militia-leader", "level": "munjip", "eras": ["1592"], "template": "{region} 읍지 의병조. {name}. {eventReign}에 왜적이 이르자 집안 곡식을 풀어 의병을 모았다." },
    { "id": "munjip-militia-member", "level": "munjip", "eras": ["1592"], "template": "{region} 읍지 의병조. 의병 {name}. 임진년 난리에 의병에 들어 싸웠다." },
    { "id": "munjip-gwageo", "level": "munjip", "eras": ["1592"], "template": "{region} 읍지 인물조. {name}. {eventReign}에 과거에 급제하였다." },
    { "id": "munjip-scholar", "level": "munjip", "eras": ["1592"], "template": "{name}의 문집 한 권이 집안에 전한다. 서문에 이르기를, 평생 글을 놓지 않았다 하였다." },
    { "id": "munjip-teacher", "level": "munjip", "eras": ["1592"], "template": "{region} 읍지 풍속조. 고을에 글을 가르치는 이가 있어, 아이들이 언문과 셈을 익혔다. 이름은 {name}이라 전한다." },
    { "id": "sillok-war-prophecy", "level": "sillok", "eras": ["1592"], "template": "{eventReign}, {term} {name}의 상소에 이르기를, 왜가 장차 바다를 건너올 것이니 남쪽 방비를 서두르라 하였다. 조정이 의아히 여겼다." },
    { "id": "sillok-hygiene", "level": "sillok", "eras": ["1592"], "template": "{eventReign}, {term} {name}의 말에 따라 각 도에 명하여 우물을 살피고 앓는 이를 따로 두게 하였다." },
    { "id": "sillok-vaccination", "level": "sillok", "eras": ["1592"], "template": "{eventReign}, {term} {name}의 청에 따라 소의 두창 고름으로 아이들에게 마마를 가볍게 앓게 하는 법을 시험하였다." },
    { "id": "sillok-famine", "level": "sillok", "eras": ["1592"], "template": "{eventReign}, {term} {name}의 말에 따라 각 도에 구황할 작물을 심게 하였다." },
    { "id": "sillok-hangul", "level": "sillok", "eras": ["1592"], "template": "{eventReign}, {term} {name}의 청에 따라 언문으로 농사와 구황의 법을 적어 백성에게 나누어 주었다." },
    { "id": "sillok-farming", "level": "sillok", "eras": ["1592"], "template": "{eventReign}, {term} {name}의 말에 따라 거름 쓰는 법을 적어 각 도에 내려보냈다." },
    { "id": "sillok-royal-death", "level": "sillok", "eras": ["1592"], "template": "{deathReign} {month}월, {term} {name} 졸. 조회를 사흘 동안 멈추었다." },
    { "id": "hojeok-1800s-yuhak", "level": "hojeok", "eras": ["1800s"], "template": "{deathReign} {region} 호적대장. 유학 {name}, 나이 {age}. 군역 칸은 비어 있다." },
    { "id": "hojeok-1800s-freed", "level": "hojeok", "eras": ["1800s"], "template": "{eventReign} {region} 호적. 양인 {name}. 신유년 내수사 노비안을 불살라 양인이 됨." },
    { "id": "hojeok-1800s-sokryang", "level": "hojeok", "eras": ["1800s"], "template": "{eventReign} {region} 호적. 양인 {name}. 속전을 바치고 노비 문서에서 이름을 지움." },
    { "id": "hojeok-1800s-yuhak-bought", "level": "hojeok", "eras": ["1800s"], "template": "{eventReign} {region} 호적대장. {name}. 이번 식년부터 직역을 유학으로 고쳐 적음." },
    { "id": "hojeok-1800s-gongmyeong", "level": "hojeok", "eras": ["1800s"], "template": "{eventReign} {region} 호적대장. {name}. 공명첩으로 받은 첨지 벼슬 이름을 직역란에 적음." },
    { "id": "jokbo-1800s-bought", "level": "jokbo", "eras": ["1800s"], "template": "{surname}씨 족보 별책. {givenName}. 뒤에 덧붙인 장에 이름이 올랐다. {deathReign} 졸." },
    { "id": "jokbo-1800s-yuhak", "level": "jokbo", "eras": ["1800s"], "template": "{surname}씨 족보. {givenName}. 벼슬 없음. {birthReign} 생, {deathReign} {month}월 졸." },
    { "id": "munjip-1800s-hong", "level": "munjip", "eras": ["1800s"], "template": "평서 난리를 적은 기록. {region} 사람 {name}. 신미년 겨울 봉기한 군에 들었다." },
    { "id": "munjip-1800s-imsul", "level": "munjip", "eras": ["1800s"], "template": "임술록. {region} 사람 {name}. 고을 봉기에 앞장섰다 하여 관아에 잡혀 왔다." },
    { "id": "munjip-1800s-martyr", "level": "munjip", "eras": ["1800s"], "template": "교우들이 남긴 순교자 기록. {region}의 교우 {name}. {eventReign}에 잡혀가 믿음을 버리지 않았다." },
    { "id": "munjip-1800s-tongcheong", "level": "munjip", "eras": ["1800s"], "template": "중인 통청 상소의 연명부. {region} 사람 {name}의 이름이 보인다." },
    { "id": "munjip-1800s-teacher", "level": "munjip", "eras": ["1800s"], "template": "{region} 읍지 인물조. {name}. 벼슬 없이 마을 아이들을 가르쳤는데, 배운 이가 많았다." },
    { "id": "sillok-1800s-reform", "level": "sillok", "eras": ["1800s"], "template": "{eventReign}, {term} {name}의 상소에 환곡의 폐단을 아뢰니, 비변사에 내려 의논케 하였다." },
    { "id": "sillok-1800s-exile", "level": "sillok", "eras": ["1800s"], "template": "{eventReign}, 역적의 공초에 {term} {name}의 이름이 나왔다. 대간이 거듭 아뢰니 섬에 안치하였다." },
    { "id": "sillok-1800s-cholera", "level": "sillok", "eras": ["1800s"], "template": "{eventReign}, {term} {name}의 청에 따라 괴질이 도는 고을에 물을 끓여 먹게 하고 앓는 이를 따로 두게 하였다." }
  ],

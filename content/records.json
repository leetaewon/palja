    { "id": "munjip-teacher", "level": "munjip", "eras": ["1592", "1800s"], "template": "{region} 읍지 풍속조. 고을에 글을 가르치는 이가 있어, 아이들이 언문과 셈을 익혔다. 이름은 {name}이라 전한다." },
    { "id": "sillok-war-prophecy", "level": "sillok", "eras": ["1592"], "template": "{eventReign}, {term} {name}의 상소에 이르기를, 왜가 장차 바다를 건너올 것이니 남쪽 방비를 서두르라 하였다. 조정이 의아히 여겼다." },
    { "id": "sillok-hygiene", "level": "sillok", "eras": ["1592", "1800s"], "template": "{eventReign}, {term} {name}의 말에 따라 각 도에 명하여 우물을 살피고 앓는 이를 따로 두게 하였다." },
    { "id": "sillok-vaccination", "level": "sillok", "eras": ["1592", "1800s"], "template": "{eventReign}, {term} {name}의 청에 따라 소의 두창 고름으로 아이들에게 마마를 가볍게 앓게 하는 법을 시험하였다." },
    { "id": "sillok-famine", "level": "sillok", "eras": ["1592", "1800s"], "template": "{eventReign}, {term} {name}의 말에 따라 각 도에 구황할 작물을 심게 하였다." },
    { "id": "sillok-hangul", "level": "sillok", "eras": ["1592", "1800s"], "template": "{eventReign}, {term} {name}의 청에 따라 언문으로 농사와 구황의 법을 적어 백성에게 나누어 주었다." },
    { "id": "sillok-farming", "level": "sillok", "eras": ["1592", "1800s"], "template": "{eventReign}, {term} {name}의 말에 따라 거름 쓰는 법을 적어 각 도에 내려보냈다." },
    { "id": "sillok-royal-death", "level": "sillok", "eras": ["1592", "1800s"], "template": "{deathReign} {month}월, {term} {name} 졸. 조회를 사흘 동안 멈추었다." },
    { "id": "hojeok-1800s-yuhak", "level": "hojeok", "eras": ["1800s"], "template": "{deathReign} {region} 호적대장. 유학 {name}, 나이 {age}. 군역 칸은 비어 있다." },
    { "id": "hojeok-1800s-freed", "level": "hojeok", "eras": ["1800s"], "template": "{eventReign} {region} 호적. 양인 {name}. 신유년 내수사 노비안을 불살라 양인이 됨." },
    { "id": "hojeok-1800s-sokryang", "level": "hojeok", "eras": ["1800s"], "template": "{eventReign} {region} 호적. 양인 {name}. 속전을 바치고 노비 문서에서 이름을 지움." },

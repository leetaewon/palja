    { "id": "hojeok-repatriation", "level": "hojeok", "eras": ["1592"], "template": "{eventReign} 쇄환 명단. {region} 사람 {name}. 일본에서 돌아옴." },
    { "id": "jokbo-yangban-male", "level": "jokbo", "eras": ["1592", "1800s"], "template": "{surname}씨 족보. {givenName}. {birthReign} 생, {deathReign} {month}월 졸." },

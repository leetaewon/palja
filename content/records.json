    { "id": "hojeok-repatriation", "level": "hojeok", "eras": ["1592"], "template": "{eventReign} 쇄환 명단. {region} 사람 {name}. 일본에서 돌아옴." },
    { "id": "jokbo-yangban-male", "level": "jokbo", "eras": ["1592"], "template": "{surname}씨 족보. {givenName}. {birthReign} 생, {deathReign} {month}월 졸." },
    { "id": "jokbo-yangban-female", "level": "jokbo", "eras": ["1592"], "template": "{surname}씨 족보. 딸. 출가함. 자녀 {children}. {deathReign} 졸." },
